{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/project-assembler/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "artifacts/project-assembler/dist"
}
